# Optional. When absent, the project uses deterministic local embeddings and an extractive answerer.
GEMINI_API_KEY=

# Optional model choices when GEMINI_API_KEY is set.
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHAT_MODEL=gemini-3.8-flash

# Retrieval/grounding knobs.
RAG_MIN_SIMILARITY=0.18
RAG_TOP_K=5

